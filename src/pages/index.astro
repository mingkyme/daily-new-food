---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [latest, ...archive] = posts;
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'short', timeZone: 'Asia/Seoul'
}).format(date);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">DAILY PRODUCT RADAR</p>
    <h1>오늘 나온 맛있는 소식,<br /><em>한눈에.</em></h1>
    <p class="hero-copy">CU·GS25·세븐일레븐·이마트24 편의점 신상품부터 식품업계의 새로운 출시까지 매일 정리합니다.</p>
  </section>

  {latest ? (
    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST ISSUE</p>
          <h2 id="latest-heading">최신 브리핑</h2>
        </div>
        <span>{formatDate(latest.data.publishedAt)}</span>
      </div>
      <a class="featured-card" href={`${base}news/${latest.id}/`}>
        <div>
          <p class="category">{latest.data.category}</p>
          <h3>{latest.data.title}</h3>
          <p>{latest.data.description}</p>
          <ul class="tag-list" aria-label="태그">
            {latest.data.tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        </div>
        <span class="read-more">브리핑 읽기 <span aria-hidden="true">→</span></span>
      </a>
    </section>
  ) : (
    <section class="empty-state">
      <h2>첫 브리핑을 준비하고 있습니다.</h2>
      <p><code>src/content/news</code>에 Markdown 파일을 추가하면 자동으로 발행됩니다.</p>
    </section>
  )}

  {archive.length > 0 && (
    <section class="archive" aria-labelledby="archive-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ARCHIVE</p>
          <h2 id="archive-heading">지난 소식</h2>
        </div>
      </div>
      <div class="post-grid">
        {archive.map((post) => (
          <article class="post-card">
            <p class="date">{formatDate(post.data.publishedAt)}</p>
            <h3><a href={`${base}news/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
