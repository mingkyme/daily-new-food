---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const home = import.meta.env.BASE_URL;
const published = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'short', timeZone: 'Asia/Seoul'
}).format(post.data.publishedAt);
---

<BaseLayout title={`${post.data.title} | 오늘의 신상 식품`} description={post.data.description}>
  <article class="article-shell">
    <a class="back-link" href={home}>← 최신 소식으로</a>
    <header class="article-header">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{published}</time>
        {post.data.updatedAt && <span>수정됨</span>}
      </div>
      <ul class="tag-list" aria-label="태그">
        {post.data.tags.map((tag: string) => <li>#{tag}</li>)}
      </ul>
    </header>
    <div class="article-layout">
      <div class="prose"><Content /></div>
      {headings.length > 0 && (
        <aside class="toc" aria-label="목차">
          <strong>이 글에서</strong>
          <ol>
            {headings.filter((h) => h.depth === 2).map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
