---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('news', ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previous: posts[index + 1], next: posts[index - 1] },
  }));
}

const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const home = import.meta.env.BASE_URL;
const published = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'short', timeZone: 'Asia/Seoul'
}).format(post.data.publishedAt);
---

<BaseLayout title={`${post.data.title} | 오늘의 신상 식품`} description={post.data.description}>
  <article class="article-shell">
    <a class="back-link" href={home}>← 최신 소식으로</a>
    <header class="article-header">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{published}</time>
        {post.data.updatedAt && <span>수정됨</span>}
      </div>
      <ul class="tag-list" aria-label="태그">
        {post.data.tags.map((tag: string) => <li>#{tag}</li>)}
      </ul>
    </header>
    <div class="article-layout">
      <div class="prose"><Content /></div>
      {headings.length > 0 && (
        <aside class="toc" aria-label="목차">
          <strong>이 글에서</strong>
          <ol>
            {headings.filter((h) => h.depth === 2).map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
    </div>
    <nav class="briefing-nav" aria-label="브리핑 이동">
      <div class="briefing-neighbors">
        {previous && <a href={`${home}news/${previous.id}/`} rel="prev">
          <span>← 이전 브리핑</span>
          <strong>{previous.data.title}</strong>
        </a>}
        {next && <a href={`${home}news/${next.id}/`} rel="next">
          <span>다음 브리핑 →</span>
          <strong>{next.data.title}</strong>
        </a>}
      </div>
      <a class="all-news" href={home}>전체 소식 보기 →</a>
    </nav>
  </article>
</BaseLayout>
